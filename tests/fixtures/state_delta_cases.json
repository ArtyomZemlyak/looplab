{
  "_": [
    "THE SHARED TRUTH TABLE for the run stream's state deltas, GENERATED by tests/test_state_delta.py",
    "(`PYTHONPATH=. python tests/test_state_delta.py`) from the Python half, looplab/events/state_delta.py.",
    "Each case applies `deltas` one after another to `base` and must reach `expected`. The Python suite",
    "refuses a stale file; ui/test/stateDelta.test.js applies every case through ui/src/stateDelta.js, so",
    "the two halves cannot disagree about what a delta means (review 2026-09-22, UI-03: they did, on",
    "`__proto__`, and the browser half wrote the difference into Object.prototype)."
  ],
  "cases": [
    {
      "name": "no change",
      "base": {},
      "deltas": [
        []
      ],
      "expected": {}
    },
    {
      "name": "a changed leaf",
      "base": {
        "a": 1
      },
      "deltas": [
        [
          [
            "set",
            [
              "a"
            ],
            2
          ]
        ]
      ],
      "expected": {
        "a": 2
      }
    },
    {
      "name": "a list arrives whole beside an added key and a removed one",
      "base": {
        "a": 1,
        "b": {
          "c": [
            1,
            2
          ]
        }
      },
      "deltas": [
        [
          [
            "del",
            [
              "a"
            ]
          ],
          [
            "set",
            [
              "b",
              "c"
            ],
            [
              1,
              2,
              3
            ]
          ],
          [
            "set",
            [
              "b",
              "d"
            ],
            null
          ],
          [
            "set",
            [
              "e"
            ],
            "x"
          ]
        ]
      ],
      "expected": {
        "b": {
          "c": [
            1,
            2,
            3
          ],
          "d": null
        },
        "e": "x"
      }
    },
    {
      "name": "a node evaluates and another appears",
      "base": {
        "nodes": {
          "0": {
            "metric": null,
            "status": "pending"
          }
        }
      },
      "deltas": [
        [
          [
            "set",
            [
              "nodes",
              "0",
              "metric"
            ],
            0.5
          ],
          [
            "set",
            [
              "nodes",
              "0",
              "status"
            ],
            "evaluated"
          ],
          [
            "set",
            [
              "nodes",
              "1"
            ],
            {
              "status": "pending"
            }
          ]
        ]
      ],
      "expected": {
        "nodes": {
          "0": {
            "metric": 0.5,
            "status": "evaluated"
          },
          "1": {
            "status": "pending"
          }
        }
      }
    },
    {
      "name": "a list of dicts is still atomic",
      "base": {
        "list": [
          {
            "a": 1
          }
        ]
      },
      "deltas": [
        [
          [
            "set",
            [
              "list"
            ],
            [
              {
                "a": 1
              },
              {
                "b": 2
              }
            ]
          ]
        ]
      ],
      "expected": {
        "list": [
          {
            "a": 1
          },
          {
            "b": 2
          }
        ]
      }
    },
    {
      "name": "a subtree collapses to a leaf",
      "base": {
        "k": {
          "deep": {
            "x": 1
          }
        }
      },
      "deltas": [
        [
          [
            "set",
            [
              "k"
            ],
            3
          ]
        ]
      ],
      "expected": {
        "k": 3
      }
    },
    {
      "name": "a leaf grows into a subtree",
      "base": {
        "k": 3
      },
      "deltas": [
        [
          [
            "set",
            [
              "k"
            ],
            {
              "deep": {
                "x": 1
              }
            }
          ]
        ]
      ],
      "expected": {
        "k": {
          "deep": {
            "x": 1
          }
        }
      }
    },
    {
      "name": "a whole subtree is deleted",
      "base": {
        "gone": {
          "x": 1
        },
        "kept": 1
      },
      "deltas": [
        [
          [
            "del",
            [
              "gone"
            ]
          ]
        ]
      ],
      "expected": {
        "kept": 1
      }
    },
    {
      "name": "a __proto__ key is added as data",
      "base": {
        "r": {}
      },
      "deltas": [
        [
          [
            "set",
            [
              "r",
              "__proto__"
            ],
            {
              "status": "ok"
            }
          ]
        ]
      ],
      "expected": {
        "r": {
          "__proto__": {
            "status": "ok"
          }
        }
      }
    },
    {
      "name": "a leaf changes inside a __proto__ key",
      "base": {
        "r": {
          "__proto__": {
            "status": "ok"
          }
        }
      },
      "deltas": [
        [
          [
            "set",
            [
              "r",
              "__proto__",
              "status"
            ],
            "polluted"
          ]
        ]
      ],
      "expected": {
        "r": {
          "__proto__": {
            "status": "polluted"
          }
        }
      }
    },
    {
      "name": "a __proto__ key is deleted",
      "base": {
        "r": {
          "__proto__": {
            "x": 1
          },
          "y": 2
        }
      },
      "deltas": [
        [
          [
            "del",
            [
              "r",
              "__proto__"
            ]
          ]
        ]
      ],
      "expected": {
        "r": {
          "y": 2
        }
      }
    },
    {
      "name": "constructor and prototype keys are added as data",
      "base": {
        "r": {}
      },
      "deltas": [
        [
          [
            "set",
            [
              "r",
              "constructor"
            ],
            {
              "prototype": {
                "polluted": true
              }
            }
          ]
        ]
      ],
      "expected": {
        "r": {
          "constructor": {
            "prototype": {
              "polluted": true
            }
          }
        }
      }
    },
    {
      "name": "a leaf changes inside constructor.prototype",
      "base": {
        "r": {
          "constructor": {
            "prototype": {
              "x": 1
            }
          }
        }
      },
      "deltas": [
        [
          [
            "set",
            [
              "r",
              "constructor",
              "prototype",
              "x"
            ],
            2
          ]
        ]
      ],
      "expected": {
        "r": {
          "constructor": {
            "prototype": {
              "x": 2
            }
          }
        }
      }
    },
    {
      "name": "the reviewer's chain: add a __proto__ subtree, then change a leaf under it",
      "base": {
        "seq": 1,
        "state": {
          "nodes": {
            "3": {
              "agent_report": {}
            }
          }
        }
      },
      "deltas": [
        [
          [
            "set",
            [
              "seq"
            ],
            2
          ],
          [
            "set",
            [
              "state",
              "nodes",
              "3",
              "agent_report",
              "__proto__"
            ],
            {
              "status": "ok"
            }
          ]
        ],
        [
          [
            "set",
            [
              "seq"
            ],
            3
          ],
          [
            "set",
            [
              "state",
              "nodes",
              "3",
              "agent_report",
              "__proto__",
              "status"
            ],
            "polluted"
          ]
        ]
      ],
      "expected": {
        "seq": 3,
        "state": {
          "nodes": {
            "3": {
              "agent_report": {
                "__proto__": {
                  "status": "polluted"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "constructor.prototype is added, changed and removed",
      "base": {
        "r": {}
      },
      "deltas": [
        [
          [
            "set",
            [
              "r",
              "constructor"
            ],
            {
              "prototype": {
                "x": 1
              }
            }
          ]
        ],
        [
          [
            "set",
            [
              "r",
              "constructor",
              "prototype",
              "x"
            ],
            2
          ]
        ],
        [
          [
            "del",
            [
              "r",
              "constructor"
            ]
          ]
        ]
      ],
      "expected": {
        "r": {}
      }
    },
    {
      "name": "a path through a missing __proto__ key creates the key",
      "base": {
        "a": {}
      },
      "deltas": [
        [
          [
            "set",
            [
              "a",
              "__proto__",
              "polluted"
            ],
            true
          ]
        ]
      ],
      "expected": {
        "a": {
          "__proto__": {
            "polluted": true
          }
        }
      }
    },
    {
      "name": "a path through missing constructor.prototype keys creates them",
      "base": {},
      "deltas": [
        [
          [
            "set",
            [
              "constructor",
              "prototype",
              "polluted"
            ],
            true
          ]
        ]
      ],
      "expected": {
        "constructor": {
          "prototype": {
            "polluted": true
          }
        }
      }
    },
    {
      "name": "deleting an absent __proto__ key is a no-op",
      "base": {
        "a": {
          "b": 1
        }
      },
      "deltas": [
        [
          [
            "del",
            [
              "a",
              "__proto__"
            ]
          ]
        ]
      ],
      "expected": {
        "a": {
          "b": 1
        }
      }
    },
    {
      "name": "a later op writes inside the value an earlier op set",
      "base": {
        "a": 1
      },
      "deltas": [
        [
          [
            "set",
            [
              "a"
            ],
            {
              "b": {
                "c": 1
              }
            }
          ],
          [
            "set",
            [
              "a",
              "b",
              "d"
            ],
            2
          ]
        ]
      ],
      "expected": {
        "a": {
          "b": {
            "c": 1,
            "d": 2
          }
        }
      }
    },
    {
      "name": "a root set, then a write into the new root",
      "base": {
        "a": 1
      },
      "deltas": [
        [
          [
            "set",
            [],
            {
              "b": {}
            }
          ],
          [
            "set",
            [
              "b",
              "c"
            ],
            3
          ]
        ]
      ],
      "expected": {
        "b": {
          "c": 3
        }
      }
    }
  ]
}
