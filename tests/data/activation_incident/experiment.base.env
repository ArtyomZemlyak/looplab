# One LoopLab node = one SFT run + one evaluation. This file is the node's knobs; run_experiment.sh
# reads it. Keep the eval knobs (EVAL_*) fixed across nodes, or the numbers stop being comparable.

# Backbone: qwen25_1.5B_instruct (current A/B reference) | qwen25_1.5B (base) | qwen35_0.8B | qwen35_2B |
#           qwen35_4B | lfm25_1.2B | lfm25_8B_A1B | qwen3_0.6B | qwen3_1.7B
BACKBONE=qwen35_0.8B

# Training budget: users sampled from train (7.55M total). One epoch over 500k users is roughly
# 1/15 of the reference run's data per epoch.
SAMPLE=500000
SFT_EVAL_SAMPLE=20000
SFT_NUM_EPOCHS=1

# Recipe (empty = the backbone's config/sft_*.yaml value)
SFT_LEARNING_RATE=
SFT_BATCH_SIZE=
SFT_MICRO_BATCH_SIZE=
SFT_EVAL_STEPS=0.25
SFT_EARLY_STOPPING_PATIENCE=2
SID_SFT_MODE=sequence
TRAIN_TASKS=1,2
# Prefix examples built from the sequence file (SID_SFT_MODE=prefix on this data): target
# positions per user; 0 = ALL (~25/user). Unused by SID_SFT_MODE=sequence.
SFT_SEQ_TARGETS_PER_USER=2

# Data variants (TRAINING_BACKBONES.md "Data variants"; all opt-in, the defaults are the v1 data every
# earlier node trained on). SFT_TARGET_MODE: item = next item of the flat stream (v1) |
# basket_boundary = history cut at a basket start, targets = that basket's items (the frozen eval's
# task) | in_cart = history + the first j items of a basket, targets = its remaining items (the
# in-cart shelf). The non-item modes need SID_SFT_MODE=prefix and data/smkt_new_v2.
# SFT_HISTORY_WINDOW: history items in a prompt (the raw export holds at most 50 per user).
SFT_TARGET_MODE=item
SFT_HISTORY_WINDOW=50
# Extra eval sets scored after the objective eval, reported as prefixed keys (in_cart ->
# InCart_*) next to the unchanged keys; "metric" stays the frozen eval's UnseenRecall@20. Empty = none.
EVAL_EXTRA_SETS=

# Parameter-efficient SFT (TRAINING_BACKBONES.md "Parameter-efficient SFT"; all opt-in, empty/none =
# full SFT as every earlier node). SFT_PEFT: none | lora (frozen body + LoRA adapters, merged into the
# weights at save: the checkpoint and the eval are unchanged). SFT_TRAIN_EMBEDDINGS (frozen body only:
# SFT_PEFT=lora or FREEZE_LLM=True): sid (default) = only the new SID token rows (input embedding +
# LM head, tied or not) | all = whole embedding + LM head | none. SFT_LORA_TARGETS: auto (attention +
# MLP + conv/linear-attention in/out projections; MoE experts and router stay frozen) | all-linear |
# comma list of module names. SFT_LORA_LR: lr for LoRA runs (empty = SFT_LEARNING_RATE / config lr;
# LoRA usually wants ~3-5x the full-SFT lr, e.g. 1e-3 for the 2e-4 configs). SFT_DEEPSPEED: override
# the config's DeepSpeed json (null = plain DDP; enough for LoRA on lfm25_8B_A1B).
# FREEZE_LLM=True (no LoRA) = body frozen, SID embedding rows only (the old frozen-LLM mode).
SFT_PEFT=none
SFT_TRAIN_EMBEDDINGS=
SFT_LORA_R=16
SFT_LORA_ALPHA=
SFT_LORA_DROPOUT=0.05
SFT_LORA_TARGETS=auto
SFT_LORA_LR=
SFT_DEEPSPEED=
FREEZE_LLM=False

# Checkpoints and disk (TRAINING_BACKBONES.md "Checkpoints and disk"). SFT_CHECKPOINTS: scratch (default:
# the best-model checkpoints live on local ${MR_ROOT}/scratch, model-only, deleted after training; only the
# final model reaches the durable mount) | output (the old checkpoint-N/ with optimizer state in the
# durable run dir) | none (no checkpoints: final model = last step, early stopping off; what DeepSpeed
# backbones (lfm25_8B_A1B) get under scratch). SFT_KEEP_FINAL_MODEL: 1 (default) keeps the final weights
# on the durable mount for re-scoring | 0 deletes them after this node's eval(s) (run_metadata.json,
# trainer_state.json, logs and the eval results stay).
SFT_CHECKPOINTS=scratch
SFT_KEEP_FINAL_MODEL=1
