# LoRA study Q2 (q2_full_lr1e-5): incremental fine-tuning on NEW events (07-08..07-14) of the v11 node-0 model
# (Qwen3.5-0.8B-Base, 1M users, InCart_FilteredUnseenRecall@20 0.1144). FT data: scripts/prepare_incremental_data.py
# (trainval tail + the week, targets = the week only, eval users excluded). Evals: frozen (08-14, unseen users),
# NEW 07-19..07-25 (gain) and OLD pre-07-08 valid users (forgetting).
BACKBONE=qwen35_0.8B
SAMPLE=-1
# SFT_EVAL_SAMPLE=-2 mirrors SAMPLE=-1: stream the WHOLE valid file (no sampling). The incremental
# week root ft_w0708 has only ~5,000 valid users (prepare_incremental_data.py: n_val = 5% of 100k),
# so any value > 5000 crashes frame.sample() in data.py:_read_sampled_frame ("Cannot take a larger
# sample than population"). The valid split only feeds mid-training eval / early stopping; the Q2
# objective comes from the frozen/NEW/OLD eval roots, so the science is untouched.
SFT_EVAL_SAMPLE=-2
SFT_NUM_EPOCHS=1
SFT_LEARNING_RATE=1e-5
SFT_BATCH_SIZE=
SFT_MICRO_BATCH_SIZE=
SFT_EVAL_STEPS=0.25
SFT_EARLY_STOPPING_PATIENCE=2
SID_SFT_MODE=prefix
TRAIN_TASKS=1,2
SFT_SEQ_TARGETS_PER_USER=0
SFT_TARGET_MODE=item
SFT_HISTORY_WINDOW=50
EVAL_EXTRA_SETS=in_cart,new_nb,new_incart,old_nb,old_incart
SFT_PEFT=none
SFT_TRAIN_EMBEDDINGS=
SFT_LORA_R=16
SFT_LORA_ALPHA=
SFT_LORA_DROPOUT=0.05
SFT_LORA_TARGETS=auto
SFT_LORA_LR=
SFT_DEEPSPEED=
FREEZE_LLM=False
SFT_CHECKPOINTS=scratch
SFT_KEEP_FINAL_MODEL=1
SFT_MODE=finetune
SFT_FINETUNE_FROM=/home/jovyan/mr-ckpt/v11n0
SFT_TRAIN_DATA_ROOT=/var/tmp/minionerec/data/incr/ft_w0708
SFT_CONFIG_FILE=
SFT_SKIP_TRAIN=0
# Disable the periodic resume checkpoint (sft_resume.py): every SFT_RESUME_EVERY_MIN minutes it writes the
# FULL optimizer+model state to the durable mount via a tmpfs staging dir, and the multi-GB optimizer.pt
# overflowed that staging dir (RuntimeError: basic_ios::clear: iostream error) at step 249, killing the run.
# run_experiment.sh:129 honors 0 = off (SFT_RESUME_DIR is then never exported and sft_resume.py no-ops).
# The scratch best-model checkpoints and the final model save to the durable output dir are unaffected.
SFT_RESUME_EVERY_MIN=0
# Streaming CSV source (SAMPLE=-1, no preloaded frame): sharded conversion round-robins ~2 CSV chunks
# across 64 workers, so ~61 workers write ZERO examples and their Arrow writers fail on finalize
# (SchemaInferenceError "Please pass features or at least one example"). Single-process conversion
# cannot produce empty shards; run_sft_jobs.sh only defaults this with ${VAR:-...}, so the value wins.
SFT_DATASET_NUM_PROC=1
