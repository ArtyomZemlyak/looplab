# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual envs
.venv*/
venv*/
env/

# Node / frontend (ui/ source is committed; deps + build output are not — `dist/` above covers ui/dist)
node_modules/
# Throwaway SSR transpile/verification harnesses. An agent generates these from ui/src to render a
# component outside the browser, then leaves them behind: 453 files / ~11 MB of machine-written .mjs
# were once committed this way, burying a 1,599-line source change under 239k lines of noise and
# leaving a plausible-looking second copy of the UI for the next agent to grep and edit by mistake.
ui/.ssr-*

# Testing
.pytest_cache/
.coverage
htmlcov/
*.xml

# Runs & data (local artifacts, not source)
runs/
cache/
*.jsonl
# checked-in fixture: the golden-log replay gate (docs/15 §P5.1)
!tests/data/golden_run_events.jsonl
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code project settings (local only)
.claude/

# Secrets / env
.env
.env.*
!.env.example
secrets.*

# Live scenario collection — generated datasets + task files (deterministic; rebuilt on demand)
examples/live_scenarios/
examples/live-*.json

# MkDocs build output (site is published by CI to GitHub Pages)
site/

# Jupyter checkpoint copies (can mirror .env with secrets — never commit)
.ipynb_checkpoints/
**/.ipynb_checkpoints/
run.md
*.log

# Local speculation rollout receipt (`looplab speculation-gate --output`). It is bound to THIS
# machine's implementation digest and GPU identity, so it is never portable and never shared.
.looplab/

# `looplab ui` build lock
ui/.looplab-ui-build.lock
# `looplab ui` staged bundle + the previous one it retires while publishing. Both are consumed by a
# normal build; only a process killed mid-publish can leave either behind (see serve/uibuild.py).
ui/.dist.looplab-stage/
ui/.dist.looplab-previous/
